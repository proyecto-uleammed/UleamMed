# Configuracion base del backend UleamMed

PROJECT_NAME=UleamMed API
VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Esta URL debe ajustarse cuando Andyy de BD confirme usuario, clave y nombre de base.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD

# Cambiar por una cadena larga, aleatoria y secreta en desarrollo real.
SECRET_KEY=REEMPLAZAR_POR_CLAVE_SECRETA_LARGA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15

# Opcional. Si no existe o no apunta a un JSON real, las notificaciones quedan como simuladas.
FIREBASE_CREDENTIALS=./firebase-credentials.example.json

# Correo opcional. Si SMTP_HOST queda vacio, los correos se muestran en logs.
# Ejemplo para Mailtrap/Resend/Brevo: copiar host, puerto, usuario y password del proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@uleammed.local
SMTP_FROM_NAME=UleamMed
SMTP_USE_TLS=true

# Durante desarrollo permite que Flutter Web consuma la API desde otro puerto.
# En produccion reemplazar * por el dominio real, por ejemplo:
# CORS_ORIGINS=https://uleammed.com,https://app.uleammed.com
CORS_ORIGINS=*

ENVIRONMENT=development
